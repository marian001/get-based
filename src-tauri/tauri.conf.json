{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "getbased",
  "version": "0.1.0",
  "identifier": "com.getbased.app",
  "build": {
    "frontendDist": "../dist-v2",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run v2:dev",
    "beforeBuildCommand": "npm run v2:build"
  },
  "app": {
    "windows": [
      {
        "title": "getbased",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://openrouter.ai https://api.anthropic.com https://api.venice.ai http://localhost:* http://127.0.0.1:*; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
